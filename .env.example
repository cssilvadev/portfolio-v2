# Enable only after the Supabase Edge Function and its server secrets are deployed.
VITE_CONTACT_FORM_ENABLED=false

# Supabase browser client. The anon key is safe to expose when RLS is enabled;
# never put a service-role key in this file or in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public Turnstile site key used by authentication and the contact form.
# Never expose Cloudflare's secret key in VITE_* variables.
VITE_TURNSTILE_SITE_KEY=

# Keep billing disabled until server deployment and payment tests are complete.
VITE_ENABLE_BILLING=false
