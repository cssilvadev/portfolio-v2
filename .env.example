# Formspree endpoint for the contact form.
# Create a free form at https://formspree.io/ and paste its endpoint here.
# Example: https://formspree.io/f/xxxxxxxx
VITE_CONTACT_FORM_ENDPOINT=

# Supabase browser client. The anon key is safe to expose when RLS is enabled;
# never put a service-role key in this file or in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional PUBLIC Turnstile site key. Configure CAPTCHA in Supabase before
# enabling this. Never expose Cloudflare's secret key in VITE_* variables.
VITE_TURNSTILE_SITE_KEY=

# Keep billing disabled until server deployment and payment tests are complete.
VITE_ENABLE_BILLING=false
