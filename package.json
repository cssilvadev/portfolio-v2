    "react-router-dom": "^7.18.2",
    "web-vitals": "^6.2.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
